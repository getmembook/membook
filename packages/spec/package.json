{
  "name": "@membook/spec",
  "version": "0.1.0-alpha.0",
  "description": "The Memfile standard — schema, anchor grammar, validator, and deterministic serialization for Membook memories",
  "license": "MIT",
  "author": "Stag.ai Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmembook/membook.git",
    "directory": "packages/spec"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:examples": "tsx scripts/generate-examples.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "tsx": "^4.20.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/getmembook/membook",
  "bugs": {
    "url": "https://github.com/getmembook/membook/issues"
  },
  "keywords": [
    "membook",
    "memfile",
    "agent-memory",
    "ai-memory",
    "coding-agent",
    "provenance",
    "schema",
    "markdown",
    "specification"
  ]
}
